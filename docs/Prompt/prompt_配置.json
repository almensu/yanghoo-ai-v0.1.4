{
  "name": "智能助手配置",
  "version": "1.0.0",
  "prompts": {
    "system": {
      "role": "assistant",
      "persona": "专业AI助手",
      "style": "友好、专业、准确"
    },
    "capabilities": [
      "文档分析",
      "代码审查", 
      "问题解答",
      "创意写作"
    ],
    "constraints": {
      "language": "中文",
      "max_tokens": 4000,
      "temperature": 0.7
    },
    "features": {
      "markdown_support": true,
      "code_highlighting": true,
      "file_references": true,
      "search_integration": true
    }
  }
} 